- pretty_path = current_page.path.gsub(/(index)?\.html/, '')
- blog_active = pretty_path.start_with?('blog')
nav.bg-base-100.shadow-sm
  .navbar.max-w-5xl.mx-auto.px-4
    .navbar-start
      .dropdown
        div tabindex="0" role="button" class="btn btn-ghost lg:hidden" aria-label="Toggle navigation"
          svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"
            path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"
        ul tabindex="0" class="menu menu-sm dropdown-content bg-base-100 rounded-box z-1 mt-3 w-52 p-2 shadow"
          li
            a href="/blog" class=(blog_active ? 'menu-active' : nil)
              | Blog
              - if blog_active
                span.sr-only  (current)
          li
            a href="/resume.pdf" Résumé
          li
            a href='/coronavirus/' Coronavirus
      a.btn.btn-ghost.text-xl href="/" COWHOLIO4
    .navbar-end.hidden.lg:flex
      ul.menu.menu-horizontal.px-1
        li
          a href="/blog" class=(blog_active ? 'menu-active' : nil)
            | Blog
            - if blog_active
              span.sr-only  (current)
        li
          a href="/resume.pdf" Résumé
        li
          a href='/coronavirus/' Coronavirus
