---
title: Blog
description: My blog
---
.max-w-3xl.mx-auto.px-4
  - categories = blog.articles.filter_map { |a| a.data.category }.uniq.sort
  - if categories.any?
    .flex.flex-wrap.gap-2.mb-5
      - categories.each do |category|
        a.badge.badge-outline href=category_path(category) =category

  - if paginate && num_pages > 1
    p.text-sm.text-base-content/70 Page #{page_number} of #{num_pages}

    - if prev_page
      p =link_to 'Previous page', prev_page

  - if page_articles.empty?
    .alert.alert-info.mt-5
      p We don't have any blog entries yet. Stay tuned for future updates.

  - page_articles.each_with_index do |article, i|
    section.mt-5
      .card.bg-base-100.shadow-sm
        .card-body
          h2.card-title=link_to article.title, article
          - if article.data.category
            a.badge.badge-outline href=category_path(article.data.category) =article.data.category
          p.text-base-content/70.text-sm =article.date.strftime('%b %e, %Y')
          .prose.max-w-none.mt-4
            = article.summary
          .card-actions.mt-4
            =link_to "Read More", article, class: 'btn btn-primary w-full'

  - if paginate
    - if next_page
      p.mt-4
        = link_to 'Next page', next_page
