- next_photo = nil
- previous_photo = nil
- @photo = photo
- photo_url = photo.media
- description = ''

/.page-header.text-center
  h3
    a href='#' =@photo.photo_album.name
section.max-w-5xl.mx-auto.px-4.mt-5 itemscope=true itemtype="http://schema.org/ImageObject"
  .grid.grid-cols-1.sm:grid-cols-12.gap-4
    / photo box
    .sm:col-span-7.relative
      img.w-full.h-auto src=photo_url
      - if previous_photo.present?
        - prev_url = nil
        - set_meta_tags prev: prev_url
        a.absolute.left-0.top-1/2.-translate-y-1/2.p-2.rounded-full.bg-black/40.text-white.hover:bg-black/60 href=prev_url alt="Previous Photo"
          svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512" class="h-5 w-5 fill-current" aria-hidden="true" focusable="false"
            path d="M41.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.3 256 246.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"
          span.sr-only Previous

      - if next_photo.present?
        - next_url = nil
        - set_meta_tags next: next_url
        a.absolute.right-0.top-1/2.-translate-y-1/2.p-2.rounded-full.bg-black/40.text-white.hover:bg-black/60 href=next_url alt="Next Photo"
          svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512" class="h-5 w-5 fill-current" aria-hidden="true" focusable="false"
            path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"
          span.sr-only Next

    / photo info
    .sm:col-span-5
      .flex.items-start.gap-3.h-20.pt-5
        img.rounded-full.mr-2 width='40px' height="40px" src=@photo.user_image_url
        .flex-1
          a href=@photo.user_url alt="User's Profile" target="_blank" =@photo.user_name
          - if @photo.venue.present?
            .span itemscope=true itemtype="http://schema.org/Place"
              p itemprop="name" =@photo.venue.name
              -if @photo.venue.latitude.present? and @photo.venue.longitude.present?
                .hidden itemprop="geo" itemscope=true itemtype="http://schema.org/GeoCoordinates"
                  span itemprop="latitude" =@photo.venue.latitude
                  span itemprop="longitude" =@photo.venue.longitude
      .mt-4
        /p.post-inner =auto_link(@photo.message, :html =>{:target => '_blank'})
        p =@photo.message
        .text-sm.text-base-content/70.mt-2
          small
            a href=@photo.url
              time datetime=@photo.message_date.to_s =Time.parse(@photo.message_date).strftime('%B %d, %Y %I:%M%p')
        /.te-post-actions.text-center
          .row
            .col-xs-3
              - description = @photo.message.present? ? CGI.escape(@photo.message) : ""
              a.pin-custom-share-button alt="Pin this on Pinterest" target="_blank" href="https://www.pinterest.com/pin/create/button/?url=#{CGI.escape(@photo_hosted_url)}&media=#{CGI.escape(photo_url)}&description=#{description}"
                svg.fa-lg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 496 512" aria-hidden="true" focusable="false"
                  path d="M496 256c0 137-111 248-248 248-25.6 0-50.2-3.9-73.4-11.1 10.1-16.5 25.2-43.5 30.8-65 3-11.6 15.4-59 15.4-59 8.1 15.4 31.7 28.5 56.8 28.5 74.8 0 128.7-68.8 128.7-154.3 0-81.9-66.9-143.2-152.9-143.2-107 0-163.9 71.8-163.9 150.1 0 36.4 19.4 81.7 50.3 96.1 4.7 2.2 7.2 1.2 8.3-3.3.8-3.4 5-20.3 6.9-28.1.6-2.5.3-4.7-1.7-7.1-10.1-12.5-18.3-35.3-18.3-56.6 0-54.7 41.4-107.6 112-107.6 60.9 0 103.6 41.5 103.6 100.9 0 67.1-33.9 113.6-78 113.6-24.3 0-42.6-20.1-36.7-44.8 7-29.5 20.5-61.3 20.5-82.6 0-19-10.2-34.9-31.4-34.9-24.9 0-44.9 25.7-44.9 60.2 0 22 7.4 36.8 7.4 36.8s-24.5 103.8-29 123.2c-5 21.4-3 51.6-.9 71.2C65.4 450.9 0 361.1 0 256 0 119 111 8 248 8s248 111 248 248z"
                span Pin
            .col-xs-3
              a.fb-custom-share-button target="_blank" href="https://www.facebook.com/sharer/sharer.php?app_id=204812569563033&sdk=joey&u=#{@photo.url}"  data-href=@photo.url
                svg.fa-lg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512" aria-hidden="true" focusable="false"
                  path d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"
                span Share

            .col-xs-3
              a target="_blank" href=@photo.url  data-href=@photo.url
                svg.fa-lg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" aria-hidden="true" focusable="false"
                  path d="M313.4 32.9c26 5.2 42.9 30.5 37.7 56.5l-2.3 11.4c-5.3 26.7-15.1 52.1-28.8 75.2H464c26.5 0 48 21.5 48 48c0 18.5-10.5 34.6-25.9 42.6C497 275.4 504 288.9 504 304c0 23.4-16.8 42.9-38.9 47.1c4.4 7.3 6.9 15.8 6.9 24.9c0 21.3-13.9 39.4-33.1 45.6c.7 3.3 1.1 6.8 1.1 10.4c0 26.5-21.5 48-48 48H294.5c-19 0-37.5-5.6-53.3-16.1l-38.5-25.7C176 420.4 160 390.4 160 358.3V320 272 247.1c0-29.2 13.3-56.7 36-75l7.4-5.9c26.5-21.2 44.6-51 51.2-84.2l2.3-11.4c5.2-26 30.5-42.9 56.5-37.7zM32 192H96c17.7 0 32 14.3 32 32V448c0 17.7-14.3 32-32 32H32c-17.7 0-32-14.3-32-32V224c0-17.7 14.3-32 32-32z"
                span Like

            .col-xs-3
              a target="_blank" href=@photo.url  data-href=@photo.url
                svg.fa-lg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" aria-hidden="true" focusable="false"
                  path d="M512 240c0 114.9-114.6 208-256 208c-37.1 0-72.3-6.4-104.1-17.9c-11.9 8.7-31.3 20.6-54.3 30.6C73.6 471.1 44.7 480 16 480c-6.5 0-12.3-3.9-14.8-9.9c-2.5-6-1.1-12.8 3.4-17.4l.3-.3c.3-.3.7-.7 1.3-1.4c1.1-1.2 2.8-3.1 4.9-5.7c4.1-5 9.6-12.4 15.2-21.6c10-16.6 19.5-38.4 21.4-62.9C17.7 326.8 0 285.1 0 240C0 125.1 114.6 32 256 32s256 93.1 256 208z"
                span Comment
